# Requires CMake 3.23 or newer (header file sets).
include_guard(GLOBAL)

# Call from a module directory. PACKAGE controls the public include prefix and
# alias namespace. TARGET changes the local build target without changing either.
function(project_add_module module)
    cmake_parse_arguments(PARSE_ARGV 1 MOD "" "PACKAGE;TARGET;TYPE" "SOURCES")
    if(MOD_UNPARSED_ARGUMENTS OR MOD_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid arguments for module ${module}: ${MOD_UNPARSED_ARGUMENTS} ${MOD_KEYWORDS_MISSING_VALUES}")
    endif()
    if(NOT MOD_PACKAGE)
        set(MOD_PACKAGE "${PROJECT_NAME}")
    endif()
    if(NOT MOD_TARGET)
        set(MOD_TARGET "${MOD_PACKAGE}_${module}")
    endif()
    if(NOT MOD_TYPE)
        set(MOD_TYPE OBJECT)
    endif()
    if(NOT MOD_TYPE MATCHES "^(OBJECT|STATIC|SHARED|INTERFACE)$")
        message(FATAL_ERROR "${module}: unsupported target type '${MOD_TYPE}'")
    endif()

    set(public_root "${CMAKE_CURRENT_SOURCE_DIR}/include")
    set(public_dir "${public_root}/${MOD_PACKAGE}/${module}")
    set(private_root "${CMAKE_CURRENT_SOURCE_DIR}/private")
    set(private_dir "${private_root}/${module}")
    foreach(visibility IN ITEMS public private)
        if(IS_DIRECTORY "${${visibility}_root}" AND NOT IS_DIRECTORY "${${visibility}_dir}")
            message(FATAL_ERROR "${module}: expected headers under ${${visibility}_dir}")
        endif()
    endforeach()

    set(sources ${MOD_SOURCES})
    if(NOT MOD_SOURCES)
        file(GLOB_RECURSE sources CONFIGURE_DEPENDS
            "src/*.cc" "src/*.cpp" "src/*.cxx")
    endif()
    if(MOD_TYPE STREQUAL "INTERFACE")
        if(sources OR IS_DIRECTORY "${private_root}")
            message(FATAL_ERROR "${module}: INTERFACE modules contain public headers only")
        endif()
        set(public_scope INTERFACE)
    else()
        if(NOT sources)
            message(FATAL_ERROR "${module}: provide SOURCES or place a translation unit under src/")
        endif()
        set(public_scope PUBLIC)
    endif()

    add_library(${MOD_TARGET} ${MOD_TYPE})
    add_library(${MOD_PACKAGE}::${module} ALIAS ${MOD_TARGET})
    set_target_properties(${MOD_TARGET} PROPERTIES EXPORT_NAME "${module}")
    if(sources)
        target_sources(${MOD_TARGET} PRIVATE ${sources})
    endif()
    if(IS_DIRECTORY "${public_dir}")
        file(GLOB_RECURSE headers CONFIGURE_DEPENDS "${public_dir}/*.h" "${public_dir}/*.hpp")
        target_sources(${MOD_TARGET} ${public_scope}
            FILE_SET public_headers TYPE HEADERS BASE_DIRS "${public_root}" FILES ${headers})
    endif()

    if(IS_DIRECTORY "${private_dir}")
        file(GLOB_RECURSE internal_headers CONFIGURE_DEPENDS "${private_dir}/*.h" "${private_dir}/*.hpp")
        target_sources(${MOD_TARGET} PRIVATE
            FILE_SET private_headers TYPE HEADERS BASE_DIRS "${private_root}" FILES ${internal_headers})
        # Only an explicit build-tree dependency grants access to these headers.
        add_library(${MOD_TARGET}_private INTERFACE)
        add_library(${MOD_PACKAGE}::${module}::private ALIAS ${MOD_TARGET}_private)
        target_include_directories(${MOD_TARGET}_private INTERFACE "$<BUILD_INTERFACE:${private_root}>")
        target_link_libraries(${MOD_TARGET}_private INTERFACE ${MOD_TARGET})
    endif()
endfunction()
